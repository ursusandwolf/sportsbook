<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="8-1" author="alex">
        <createTable tableName="sports">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>

        <createTable tableName="sport_events">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sport_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_event_sport" referencedTableName="sports" referencedColumnNames="id"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="home_participant" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="away_participant" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="starts_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValue="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="markets">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_market_event" referencedTableName="sport_events" referencedColumnNames="id"/>
            </column>
            <column name="market_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValue="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="selections">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="market_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_selection_market" referencedTableName="markets" referencedColumnNames="id"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="odds" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValue="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="sport_events" indexName="idx_event_starts_at">
            <column name="starts_at"/>
        </createIndex>
        <createIndex tableName="sport_events" indexName="idx_event_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="markets" indexName="idx_market_event_id">
            <column name="event_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="8-2" author="alex">
        <insert tableName="sports">
            <column name="name" value="Football"/>
        </insert>
        <insert tableName="sports">
            <column name="name" value="Basketball"/>
        </insert>
        <insert tableName="sports">
            <column name="name" value="Tennis"/>
        </insert>
    </changeSet>

</databaseChangeLog>
