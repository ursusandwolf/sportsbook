<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="009-create-bets" author="alex">
        <createTable tableName="bets">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_bet_user" referencedTableName="users" referencedColumnNames="id"/>
            </column>
            <column name="selection_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_bet_selection" referencedTableName="selections" referencedColumnNames="id"/>
            </column>
            <column name="stake" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="odds_at_placement" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="potential_payout" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="placed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="bets" indexName="idx_bet_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
